#!/bin/sh
set -e

if [ -n "$SKIP_PRE_PUSH" ]; then
  echo "Skipping pre-push checks because SKIP_PRE_PUSH is set."
  exit 0
fi

cd client
if [ ! -d node_modules ]; then
  echo "Missing client/node_modules. Run npm ci in ./client before pushing."
  exit 1
fi
npm run type-check

cd ../backend
if [ ! -d node_modules ]; then
  echo "Missing backend/node_modules. Run npm ci in ./backend before pushing."
  exit 1
fi
npm run type-check
npm run test:unit
# Integration tests run in CI to keep local pre-push feedback fast.
