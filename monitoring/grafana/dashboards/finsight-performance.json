        {
          "expr": "sum(finsight_mongodb_pool_connections{state=\"ready\"})",
          "legendFormat": "Ready"
        },
        {
          "expr": "sum(finsight_mongodb_pool_connections{state=\"checked_out\"})",
          "legendFormat": "Checked out"
        }
      ],
      "title": "MongoDB connection pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
