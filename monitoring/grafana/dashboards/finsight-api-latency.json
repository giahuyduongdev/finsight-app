      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "id": 6,
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route, method) (rate(finsight_http_request_duration_seconds_bucket{route!~\"/metrics|/health|/ready\"}[5m]))))",
