      "id": 7,
      "targets": [
        {
          "expr": "sum by (route, method) (rate(finsight_http_requests_total{route!~\"/metrics|/health|/ready\"}[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{method}} {{route}}"
        }
      ],
      "title": "Endpoint request volume",
      "type": "table"
