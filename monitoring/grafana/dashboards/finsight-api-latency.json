      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(finsight_http_request_duration_seconds_bucket{route!~\"/metrics|/health|/ready\", route=~\"$route\", method=~\"$method\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "title": "Whole API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
