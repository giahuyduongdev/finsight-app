# ═══════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ─── MongoDB Configuration ────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/finsight

# Connection Pool Settings
MONGO_MAX_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT=5000
MONGO_SOCKET_TIMEOUT=45000
MONGO_CONNECT_TIMEOUT=10000
MONGO_MAX_POOL_SIZE_PER_CORE=2

# Memory Management
MEMORY_THRESHOLD_MB=512

# ─── Redis Configuration ──────────────────────────────────────────────────────
# Local Redis
REDIS_URL=redis://localhost:6379
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Cloud Redis (Upstash) - Optional
UPSTASH_REDIS_URL=your-upstash-redis-url

# ═══════════════════════════════════════════════════════════════════════════
# NOTES:
# - For production, use MongoDB Atlas or managed MongoDB service
# - For Redis, consider Upstash or Redis Cloud for production
# - Adjust pool sizes based on your server resources
# ═══════════════════════════════════════════════════════════════════════════
