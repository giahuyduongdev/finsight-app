flowchart TD
    A[Feature / Enhancement Request]
    A --> B["Clarify Request<br/>brainstorming"]
    B --> C["Generate Requirements<br/>requirements.md"]
    C --> D["Requirements Review<br/>grill-with-docs"]
    D --> E["Explore Solutions<br/>brainstorming"]
    E --> F["Generate Design<br/>design.md"]
    F --> G["Design Review<br/>grill-with-docs"]
    G --> H["Generate Feature Diagrams<br/>sequence.mmd if useful"]
    H --> I["Research If Needed<br/>deep-research"]
    I --> J["Architecture Decisions<br/>ADR if needed"]
    J --> K["Generate Tasks<br/>tasks.md"]
    K --> L["Create Branch / Worktree<br/>using-git-worktrees"]
    L --> M["TDD / Minimal Verification<br/>tdd if testable"]
    M --> N["Verification<br/>verification-loop"]
    N --> O["Security Review<br/>security-review"]
    O --> P["Finish Development Branch<br/>finishing-a-development-branch"]
    P --> Q[Done]
